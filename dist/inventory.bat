@echo off
chcp 65001 >nul 2>&1
setlocal
set "HERE=%~dp0"
set "EXE=%HERE%winsuitex.exe"
REM Trace is ON by default: ops staff double-clicks, no params to remember.
set "DEBUG_MODE=0"
set "TRACE_MODE=1"
if /i "%~1"=="debug" set "DEBUG_MODE=1"
if /i "%~1"=="-debug" set "DEBUG_MODE=1"

if not exist "%EXE%" (
    echo ERROR: winsuitex.exe not found next to this bat.
    echo Expected location: %EXE%
    pause
    exit /b 2
)

REM cd to the working folder so wmi_debug.log lands here too.
cd /d "%HERE%"

echo Usage: just double-click this file (trace.log is generated by default)
echo        For WMI diagnostics, run: inventory.bat debug
echo.
echo ============================================================
echo  EXE info (confirm you are running the freshly built binary)
echo ============================================================
echo  BAT_VER=2026-09-22  (if this line is missing, you are running an OLD bat)
REM --version is diagnostic only: stderr is discarded, failure never blocks collection.
REM (early nightly + panic=abort builds crashed printing Chinese on Win7 console;
REM  the exe now bypasses the std writer internally, so this line is safe to keep)
"%EXE%" --version 2>nul
for %%F in ("%EXE%") do echo   mtime = %%~tF      size = %%~zF bytes
echo.

if "%DEBUG_MODE%"=="1" (
    set WSX_WMI_DEBUG=1
    echo [debug mode] WMI diagnostics on, will write wmi_debug.log
    if exist "wmi_debug.log" del /f /q "wmi_debug.log" >nul 2>&1
    echo.
)

if "%TRACE_MODE%"=="1" (
    set WSX_TRACE=1
    echo [trace] on by default, will write trace.log [GPU telemetry rc per step]
    if exist "trace.log" del /f /q "trace.log" >nul 2>&1
    echo.
)

REM Record mtime before, to detect a failed or stale write.
set "JSON_BEFORE="
set "HTML_BEFORE="
if exist "%HERE%inventory.json" for %%F in ("%HERE%inventory.json") do set "JSON_BEFORE=%%~tF"
if exist "%HERE%inventory.html" for %%F in ("%HERE%inventory.html") do set "HTML_BEFORE=%%~tF"

echo Target folder: %HERE%
echo Collecting hardware info (keyboard/mouse, audio, nic, disk)...
echo.

REM The exe prints JSON/HTML to STDOUT; cmd.exe redirects it to a file here.
REM The file is created by cmd.exe (a trusted process), NOT by winsuitex.exe,
REM so a process-name-based filter watching winsuitex.exe writes can't delete it.
REM We write straight to %HERE% (this bat's own folder) so the output never
REM depends on %TEMP%, which can be missing / uneditable on some servers.

set "JSON_OUT=%HERE%inventory.json"
set "HTML_OUT=%HERE%inventory.html"
set "TRACE_LOG=%HERE%trace.log"

REM trace goes to stderr (unbuffered), must be redirected separately.
if "%TRACE_MODE%"=="1" (
    "%EXE%" --json - > "%JSON_OUT%" 2> "%TRACE_LOG%"
) else (
    "%EXE%" --json - > "%JSON_OUT%"
)
if errorlevel 1 (
    echo ERROR: hardware collection failed - exe exit nonzero.
    pause
    exit /b 1
)
if not exist "%JSON_OUT%" (
    echo ERROR: JSON output missing after exe returned success.
    echo ----- trace.log [exe stderr] follows -----
    if exist "%TRACE_LOG%" (type "%TRACE_LOG%") else (echo    trace.log not generated)
    echo -----------------------------------------------
    pause
    exit /b 1
)
set "JSZ=0"
for %%F in ("%JSON_OUT%") do set "JSZ=%%~zF"
if %JSZ% LSS 1000 (
    echo ERROR: JSON is only %JSZ% bytes - looks like an OLD exe.
    pause
    exit /b 1
)

REM capture report stderr too (was lost to console, making HTML failures invisible)
"%EXE%" --report - > "%HTML_OUT%" 2>> "%TRACE_LOG%"
if not "%errorlevel%"=="0" (
    echo ERROR: report generation failed - exe exit code = %errorlevel%.
    echo ----- trace.log dump [exe stderr, incl. report step] follows -----
    if exist "%TRACE_LOG%" (type "%TRACE_LOG%") else (echo    trace.log not generated)
    echo -----------------------------------------------
    pause
    exit /b 1
)
if not exist "%HTML_OUT%" (
    echo ERROR: HTML output missing after exe returned success.
    echo ----- trace.log dump [exe stderr, incl. report step] follows -----
    if exist "%TRACE_LOG%" (type "%TRACE_LOG%") else (echo    trace.log not generated)
    echo -----------------------------------------------
    pause
    exit /b 1
)
set "HSZ=0"
for %%F in ("%HTML_OUT%") do set "HSZ=%%~zF"
if %HSZ% LSS 1000 (
    echo ERROR: HTML is only %HSZ% bytes - looks like an OLD exe.
    pause
    exit /b 1
)

echo.
echo ============================================================
echo  Output check (compare mtime to confirm it really refreshed)
echo ============================================================
set "COPYFAIL=0"
if not exist "%HERE%inventory.json" (
    echo [FAIL] inventory.json missing, write failed!
    set "COPYFAIL=1"
) else (
    for %%F in ("%HERE%inventory.json") do (
        echo   inventory.json : %%~tF  ^(%%~zF bytes^)
        if "%%~tF"=="%JSON_BEFORE%" (
            echo   [WARN] mtime not refreshed - output may be stale!
            set "COPYFAIL=1"
        )
    )
)
if not exist "%HERE%inventory.html" (
    echo [FAIL] inventory.html missing, write failed!
    set "COPYFAIL=1"
) else (
    for %%F in ("%HERE%inventory.html") do (
        echo   inventory.html : %%~tF  ^(%%~zF bytes^)
        if "%%~tF"=="%HTML_BEFORE%" (
            echo   [WARN] mtime not refreshed - output may be stale!
            set "COPYFAIL=1"
        )
    )
)

REM The collection timestamp inside JSON is more authoritative than file mtime.
echo.
echo Data collection time (collected_at):
findstr /c:"collected_at" "%HERE%inventory.json"
echo.

if "%COPYFAIL%"=="1" (
    echo [FAIL] output write failed, these paths were expected but missing/unchanged:
    echo   %JSON_OUT%
    echo   %HTML_OUT%
    pause
    exit /b 3
)

echo Done.
echo   JSON : %HERE%inventory.json ^(%JSZ% bytes^)
echo   HTML : %HERE%inventory.html ^(%HSZ% bytes^)

if "%TRACE_MODE%"=="1" (
    echo.
    echo ============================================================
    echo  GPU telemetry trace [key: where temp/fan actually stall]
    echo ============================================================
    if exist "trace.log" (
        findstr /c:"[gpu.tel]" "trace.log"
        echo.
        echo   full log: %HERE%trace.log
    ) else (
        echo  [WARN] trace.log not generated - confirm you use the trace-enabled exe
    )
)

if "%DEBUG_MODE%"=="1" (
    echo.
    echo ------------------------------------------------------------
    echo  Debug log wmi_debug.log :
    if exist "wmi_debug.log" (
        for %%F in ("wmi_debug.log") do echo    %HERE%wmi_debug.log  ^(%%~zF bytes^)
        echo  send this file too - it pinpoints NVMe collection failure
    ) else (
        echo    [WARN] not generated - check the exe is the diagnostic build
    )
    echo ------------------------------------------------------------
)

echo Opening report...
start "" "%HERE%inventory.html"
pause
endlocal
