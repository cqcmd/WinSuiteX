#include <windows.h>
#include "resource.h"
#pragma code_page(65001)

// WinSuiteXShell.dll 的版本信息（无 RT_MANIFEST：故意不带提权清单，
// 这样才能被 Explorer 作为进程内 COM 服务器正常加载）。
VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,7,0,261008
PRODUCTVERSION 1,7,0,261008
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName", "重庆持玛多网络科技有限公司"
            VALUE "FileDescription", "WinSuiteX Shell Server"
            VALUE "FileVersion", "1.7.0.20261008"
            VALUE "InternalName", "WinSuiteXShell"
            VALUE "LegalCopyright", "持玛多网络 / Z.W."
            VALUE "OriginalFilename", "WinSuiteXShell.dll"
            VALUE "ProductName", "WinSuiteX"
            VALUE "ProductVersion", "1.7.0.20261008"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
